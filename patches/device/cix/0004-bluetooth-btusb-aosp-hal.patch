diff --git a/sky1/sky1_orion_o6/SharedKernelConfig.mk b/sky1/sky1_orion_o6/SharedKernelConfig.mk
index 77ad2b1..6d22602 100644
--- a/sky1/sky1_orion_o6/SharedKernelConfig.mk
+++ b/sky1/sky1_orion_o6/SharedKernelConfig.mk
@@ -46,8 +46,9 @@ BOARD_VENDOR_KERNEL_MODULES += \
     $(TARGET_OUT_INTERMEDIATES)/KERNEL_OBJ/drivers/media/platform/cix/csi_dma/csi_dma.ko \
     $(TARGET_OUT_INTERMEDIATES)/KERNEL_OBJ/drivers/media/i2c/cix/lt7911uxc/lt7911uxc.ko \
     $(TARGET_OUT_INTERMEDIATES)/KERNEL_OBJ/drivers/media/platform/cix/cix_isp/armcb_isp.ko \
-    $(TARGET_OUT_INTERMEDIATES)/KERNEL_OBJ/drivers/bluetooth/rtk_btusb.ko \
-    $(TARGET_OUT_INTERMEDIATES)/KERNEL_OBJ/net/rfkill/rfkill-bt.ko \
+    $(TARGET_OUT_INTERMEDIATES)/KERNEL_OBJ/drivers/bluetooth/btintel.ko \
+    $(TARGET_OUT_INTERMEDIATES)/KERNEL_OBJ/drivers/bluetooth/btrtl.ko \
+    $(TARGET_OUT_INTERMEDIATES)/KERNEL_OBJ/drivers/bluetooth/btusb.ko \
     $(TARGET_OUT_INTERMEDIATES)/RTL_WIFI_OBJ/rtl_wlan.ko \
     $(TARGET_OUT_INTERMEDIATES)/KERNEL_OBJ/sound/soc/cix/snd-soc-sky1-sound-card.ko
 
diff --git a/sky1/sky1_orion_o6/android_addition_defconfig b/sky1/sky1_orion_o6/android_addition_defconfig
index fadcd35..b0f6413 100644
--- a/sky1/sky1_orion_o6/android_addition_defconfig
+++ b/sky1/sky1_orion_o6/android_addition_defconfig
@@ -18,3 +18,14 @@ CONFIG_DRM_LINLONDP=y
 CONFIG_DRM_CIX=y
 CONFIG_DRM_CIX_VIRTUAL=y
 CONFIG_BLK_DEV_DM=y
+
+# Orion O6 Bluetooth fix: upstream btusb + btrtl (creates hci0, loads rtl_bt/rtl8852bu_fw.bin)
+# instead of Realtek's rtk_btusb, which only works with Realtek's Android HAL (not in this tree).
+# CONFIG_BT_RTKBTUSB is not set
+CONFIG_BT_HCIBTUSB=m
+CONFIG_BT_HCIBTUSB_RTL=y
+CONFIG_BT_HCIBTUSB_BCM=y
+# CONFIG_BT_HCIBTUSB_MTK is not set
+# CONFIG_BT_HCIBTUSB_AUTOSUSPEND is not set
+CONFIG_BT_RTL=m
+CONFIG_BT_INTEL=m
