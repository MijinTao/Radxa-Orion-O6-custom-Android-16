diff --git a/sky1/sky1_orion_o6/sky1_orion_o6.mk b/sky1/sky1_orion_o6/sky1_orion_o6.mk
index a4cf232..d18a903 100644
--- a/sky1/sky1_orion_o6/sky1_orion_o6.mk
+++ b/sky1/sky1_orion_o6/sky1_orion_o6.mk
@@ -459,3 +459,13 @@ PRODUCT_PACKAGES += \
 # AOSP template directly. Without it wpa_supplicant refuses to add wlan0 and Wi-Fi turns itself off.
 PRODUCT_COPY_FILES += \
     external/wpa_supplicant_8/wpa_supplicant/wpa_supplicant_template.conf:$(TARGET_COPY_OUT_VENDOR)/etc/wifi/wpa_supplicant.conf
+
+# Orion O6 Bluetooth fix: the Realtek rtkbt HAL (hardware/realtek) and CIX's cixbt HAL are not in this
+# tree, so no IBluetoothHci was installed and com.android.bluetooth aborted at start. Use AOSP's
+# default AIDL HAL, which drives hci0 (upstream btusb + btrtl) through HCI_CHANNEL_USER.
+ifneq ($(CIX_DOCKER_MODE),docker)
+PRODUCT_PACKAGES := $(filter-out android.hardware.bluetooth-service.cixbt android.hardware.bluetooth-service.rtkbt,$(PRODUCT_PACKAGES))
+PRODUCT_PACKAGES += android.hardware.bluetooth-service.default
+PRODUCT_COPY_FILES += \
+    $(CIX_DEVICE_PATH)/firmware/rtl_bt/rtl8852bu_fw.bin:$(TARGET_COPY_OUT_VENDOR)/firmware/rtl_bt/rtl8852bu_fw.bin
+endif
