+// dmod: mouse click as touch -----------------------------------------------------------------
+// A mouse gesture that starts with the primary (left) button is re-sourced as a single-finger
+// touchscreen gesture: DOWN/MOVE/UP/CANCEL become touch events at the cursor position,
+// BUTTON_PRESS/BUTTON_RELEASE (and scrolls during the gesture) are dropped, and an open hover
+// stream is closed with HOVER_EXIT first so the dispatcher sees consistent streams per device.
+// The cursor itself is still moved and drawn by processMouseEventLocked() before this runs.
+void PointerChoreographer::setMouseClickAsTouchEnabled(bool enabled) {
+    std::scoped_lock _l(getLock());
+    mDmodMouseClickAsTouchEnabled = enabled;
+}
+
+static NotifyMotionArgs dmodToTouch(const NotifyMotionArgs& args) {
+    NotifyMotionArgs t(args);
+    t.source = AINPUT_SOURCE_TOUCHSCREEN;
+    t.pointerProperties[0].toolType = ToolType::FINGER;
+    t.pointerProperties[0].id = 0;
+    t.buttonState = 0;
+    t.actionButton = 0;
+    t.xCursorPosition = AMOTION_EVENT_INVALID_CURSOR_POSITION;
+    t.yCursorPosition = AMOTION_EVENT_INVALID_CURSOR_POSITION;
+    t.pointerCoords[0].setAxisValue(AMOTION_EVENT_AXIS_PRESSURE, 1.0f);
+    t.pointerCoords[0].setAxisValue(AMOTION_EVENT_AXIS_RELATIVE_X, 0.0f);
+    t.pointerCoords[0].setAxisValue(AMOTION_EVENT_AXIS_RELATIVE_Y, 0.0f);
+    return t;
+}
+
+std::vector<NotifyMotionArgs> PointerChoreographer::dmodMouseClickAsTouch(
+        const NotifyMotionArgs& args) {
+    std::scoped_lock _l(getLock());
+    if (args.getPointerCount() != 1 ||
+        !isFromMouse(args.source, args.pointerProperties[0].toolType)) {
+        return {args};
+    }
+    const DeviceId dev = args.deviceId;
+    const int32_t action = MotionEvent::getActionMasked(args.action);
+
+    if (mDmodTouchingMice.count(dev) == 0) {
+        if (mDmodMouseClickAsTouchEnabled && action == AMOTION_EVENT_ACTION_DOWN &&
+            (args.buttonState & AMOTION_EVENT_BUTTON_PRIMARY) != 0) {
+            std::vector<NotifyMotionArgs> out;
+            if (mDmodHoveringMice.erase(dev) > 0) {
+                NotifyMotionArgs exitArgs(args);
+                exitArgs.id = mDmodIdGenerator.nextId();
+                exitArgs.action = AMOTION_EVENT_ACTION_HOVER_EXIT;
+                exitArgs.actionButton = 0;
+                exitArgs.buttonState = 0;
+                out.push_back(exitArgs);
+            }
+            out.push_back(dmodToTouch(args));
+            mDmodTouchingMice.insert(dev);
+            return out;
+        }
+        // Plain mouse event: pass through, remember whether a hover stream is open.
+        if (action == AMOTION_EVENT_ACTION_HOVER_ENTER || action == AMOTION_EVENT_ACTION_HOVER_MOVE) {
+            mDmodHoveringMice.insert(dev);
+        } else if (action == AMOTION_EVENT_ACTION_HOVER_EXIT || action == AMOTION_EVENT_ACTION_DOWN) {
+            mDmodHoveringMice.erase(dev);
+        }
+        return {args};
+    }
+
+    // A converted gesture is in progress for this mouse (kept until UP even if toggled off).
+    switch (action) {
+        case AMOTION_EVENT_ACTION_MOVE:
+            return {dmodToTouch(args)};
+        case AMOTION_EVENT_ACTION_UP:
+        case AMOTION_EVENT_ACTION_CANCEL:
+            mDmodTouchingMice.erase(dev);
+            return {dmodToTouch(args)};
+        default:  // BUTTON_PRESS / BUTTON_RELEASE / SCROLL while "touching"
+            return {};
+    }
+}
