@@ -733,7 +757,21 @@ static int cdnsp_sky1_suspend(struct device *dev)
 
 static int cdnsp_sky1_system_suspend(struct device *dev)
 {
+	struct cdnsp_sky1 *data = dev_get_drvdata(dev);
+
+	/*
+	 * The controller only goes to D3 in host role, and not at all if D3
+	 * entry timed out; then it is still clocked and in use. Gate the AXI
+	 * and SOF clocks only once AXI_CLOCK_VALID has dropped (as in CIX's
+	 * mainline glue driver, v9): gating a live controller can hang the bus.
+	 */
+	data->clks_gated = false;
+	if (readl(data->ctst_base) & AXI_CLOCK_VALID) {
+		dev_dbg(dev, "controller still active, clocks left on\n");
+		return 0;
+	}
 	sky1_usb_clk_disable_suspend(dev);
+	data->clks_gated = true;
 	return 0;
 }
 
@@ -742,8 +780,11 @@ static int cdnsp_sky1_system_resume(struct device *dev)
 	int ret = 0;
 	struct cdnsp_sky1 *data;
 
-	ret = sky1_usb_clk_enable_resume(dev);
 	data = dev_get_drvdata(dev);
+	if (data->clks_gated) {
+		ret = sky1_usb_clk_enable_resume(dev);
+		data->clks_gated = false;
+	}
 	writel(CIX_USB_AXI_WR_CACHE_VALUE, data->axi_base);
 	return ret;
 }
