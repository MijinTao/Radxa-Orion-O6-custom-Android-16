+	ret = rts5453h_event_handler(rts, 1, true);
+	if (ret < 0) {
 		dev_err(&client->dev, "typec event handling error %d", ret);
 		return ret;
 	}
@@ -635,10 +675,17 @@ static int rts5453h_resume(struct device *dev)
 {
 	struct i2c_client *client = to_i2c_client(dev);
 
+	struct rts5453h *rts = i2c_get_clientdata(client);
+
 	if (device_may_wakeup(dev)) {
 		disable_irq_wake(client->irq);
-		dev_info(&client->dev, "enable irq");
+		dev_dbg(&client->dev, "enable irq");
 	}
+	/*
+	 * Read back (and acknowledge) what happened while suspended before
+	 * unmasking the level-triggered line, so a pending event can't loop.
+	 */
+	rts5453h_event_handler(rts, 1, true);
 	enable_irq(client->irq);
 
 	return 0;
@@ -657,8 +704,8 @@ static int rts5453h_restore(struct device *dev)
 	enable_irq(client->irq);
 
 	/* Re-trigger PD event if PD event occurs during std */
-	ret = rts5453h_event_handler(rts, 0);
-	if (ret) {
+	ret = rts5453h_event_handler(rts, 0, true);
+	if (ret < 0) {
 		dev_err(&client->dev, "typec event handling error %d", ret);
 		return ret;
 	}
