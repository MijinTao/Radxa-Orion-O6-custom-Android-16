 struct arm_dma350_phy {
@@ -140,6 +146,94 @@ static dma_addr_t phy_cmd0[MAX_CHAN_NUM];
 
 static atomic_t vaild_chan_id[MAX_CHAN_NUM];
 
+/*
+ * The cyclic (audio) position is derived from the number of "period done"
+ * interrupts. When two periods complete before the handler runs (interrupt
+ * latency above one period, 5.3 ms for 256 frames at 48 kHz), only one
+ * interrupt is seen and the position ALSA gets stays one period behind the
+ * hardware for good; each further miss adds a period, until the application
+ * writes into the part of the ring the DMA has already played (robotic
+ * sound, then garbage/silence). The position is now read from the hardware
+ * (current linked command and what is left of it, like CIX's mainline
+ * DMA-350 cyclic support); the interrupt count is only a fallback, and is
+ * resynchronised from the hardware - such misses are counted here.
+ */
+static unsigned int lost_periods;
+module_param(lost_periods, uint, 0444);
+MODULE_PARM_DESC(lost_periods, "Cyclic period interrupts found missing and resynchronised from hardware");
+
+/*
+ * Byte offset of the channel inside its cyclic ring, or -1 if unknown.
+ * As in CIX's mainline DMA-350 cyclic support: CH_LINKADDR points at the
+ * command after the one executing, so it identifies the current period, and
+ * the destination part of CH_XSIZE/CH_XSIZEHI is what is left of it. Retry
+ * if the channel moved to the next command between the reads.
+ */
+static long arm_dma350_cyclic_hw_offset(struct arm_dma350_chan *c,
+					struct arm_dma350_phy *p)
+{
+	u32 n = c->cyc_periods, link, link2, xs, xshi, next, cur;
+	u64 rem;
+	int retries = 3;
+
+	if (!p || !c->cyc_len || !c->cyc_period || !n || !c->transize)
+		return -1;
+	do {
+		link = readl_relaxed(p->base + DMA350_REG_LINKADDR);
+		xs = readl_relaxed(p->base + DMA350_REG_XSIZE);
+		xshi = readl_relaxed(p->base + DMA350_REG_XSIZEHI);
+		link2 = readl_relaxed(p->base + DMA350_REG_LINKADDR);
+		if (link != link2)
+			continue;
+		link &= ~DMA350_CH_LINKADDR_LINKADDREN;
+		for (next = 0; next < n; next++)
+			if (c->cyc_cmd_addr[next] == link)
+				break;
+		if (next == n)
+			return -1;
+		rem = ((xs & DMA350_CH_XSIZE_DESXSIZE_Msk) >> DMA350_CH_XSIZE_DESXSIZE_Pos) |
+		      ((u64)((xshi & DMA350_CH_XSIZEHI_DESXSIZEHI_Msk) >>
+			     DMA350_CH_XSIZEHI_DESXSIZEHI_Pos) << 16);
+		rem *= c->transize;
+		if (rem > c->cyc_period)
+			continue;
+		cur = next ? next - 1 : n - 1;
+		return (long)(((u64)(cur + 1) * c->cyc_period - rem) % c->cyc_len);
+	} while (--retries);
+
+	return -1;
+}
+
+/*
+ * Called after desnum[] was advanced for a period interrupt, with the ring
+ * offset read before the interrupt status was cleared (a period finishing
+ * after the clear raises a new interrupt and must not be counted here; one
+ * finishing before it would otherwise be lost). desnum[] counts
+ * completed periods 1..n, so the hardware should now be in period desnum % n.
+ * If it is already 1..n-2 periods further, those period interrupts were
+ * lost: count them and move desnum[] along. A difference of n-1 (hardware
+ * apparently behind) is ignored, as is an unknown hardware position - in
+ * both cases the count behaves as before.
+ */
+static void arm_dma350_cyclic_resync(struct arm_dma350_chan *c, long off, u32 ch)
+{
+	u32 n = dmachan[ch], hw_idx, sw_idx, diff;
+
+	if (n < 3 || off < 0 || !c->cyc_period)
+		return;
+	hw_idx = (u32)off / c->cyc_period;
+	sw_idx = desnum[ch] % n;
+	diff = (hw_idx + n - sw_idx) % n;
+	if (diff == 0 || diff > n - 2)
+		return;
+
+	lost_periods += diff;
+	pr_warn_once("arm-dma350: cyclic period interrupts were lost, position resynchronised from hardware (count in /sys/module/arm_dma350/parameters/lost_periods)\n");
+	desnum[ch] += diff;
+	while (desnum[ch] > n)
+		desnum[ch] -= n;
+}
