 	return transfer->len;
@@ -627,7 +639,7 @@ static int cdns_spi_probe(struct platform_device *pdev)
 	if (IS_ERR(xspi->spi_reset)) {
 		dev_err(&pdev->dev, "[%s:%d]get reset error\n", __func__, __LINE__);
 		ret = PTR_ERR(xspi->spi_reset);
-		goto clk_dis_all;
